{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ts-studio.local/contracts/asset-manifest.schema.json",
  "title": "TS STUDIO Asset Manifest",
  "description": "Task-scoped declaration of repository binary assets. Every entry binds a repository-relative path to the raw-byte SHA-256 of the file, with no text line-ending normalisation applied. Enforced by studio_core/binary_assets.py under policies/binary-assets.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "task_id",
    "policy_version",
    "hash_algorithm",
    "assets",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "pattern": "^AM-[A-Z0-9-]+-[0-9]{4}$"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[A-Z][A-Z0-9]+-[0-9]{4}$"},
    "policy_version": {"type": "string", "minLength": 3},
    "hash_algorithm": {
      "const": "sha256-raw-bytes",
      "description": "Pinned so a manifest can never claim a text-normalised digest. The gate recomputes sha256 over the untouched file bytes."
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/assetEntry"}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "notes": {"type": "string", "minLength": 3}
  },
  "$defs": {
    "assetEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "content_hash", "byte_size", "source", "rights"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 5,
          "maxLength": 400,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "description": "Repository-relative POSIX path. A leading separator, a drive letter and a backslash are unrepresentable here, and the gate independently rejects '..' segments, absolute paths and symlinks before it opens the file."
        },
        "media_type": {"enum": ["image/png", "image/webp"]},
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "sha256 of the raw file bytes. Required: an entry without it is schema-invalid, which the gate treats as a rejection rather than a pass."
        },
        "byte_size": {"type": "integer", "minimum": 1},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "created_by", "provider", "model"],
          "properties": {
            "kind": {"enum": ["HUMAN", "AI_GENERATED", "AI_ASSISTED", "TOOL_GENERATED", "IMPORTED"]},
            "created_by": {"oneOf": [{"type": "string", "pattern": "^A-[0-9]{2}$"}, {"const": "USER"}]},
            "provider": {"type": ["string", "null"]},
            "model": {"type": ["string", "null"]}
          }
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["license", "commercial_use", "training_permission", "provenance_complete"],
          "properties": {
            "license": {"type": "string", "minLength": 2},
            "commercial_use": {"type": "boolean"},
            "training_permission": {"enum": ["ALLOWED", "NOT_ALLOWED", "NOT_APPLICABLE", "UNKNOWN"]},
            "provenance_complete": {"type": "boolean"}
          }
        },
        "artifact_id": {"type": ["string", "null"], "pattern": "^ART-[A-Z0-9-]+-[0-9]{4}$"}
      }
    }
  }
}
