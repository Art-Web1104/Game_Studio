{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ts-studio.local/contracts/task.schema.json",
  "title": "TS STUDIO Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "project_id",
    "title",
    "goal",
    "owner_agent_id",
    "status",
    "risk_class",
    "inputs",
    "deliverables",
    "acceptance_criteria",
    "dependencies",
    "budget",
    "approvers",
    "rollback",
    "security",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[A-Z][A-Z0-9]+-[0-9]{4}$"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,40}$"},
    "title": {"type": "string", "minLength": 5, "maxLength": 120},
    "goal": {"type": "string", "minLength": 20},
    "owner_agent_id": {"$ref": "#/$defs/agentId"},
    "status": {
      "enum": ["DRAFT", "READY", "IN_PROGRESS", "REVIEW", "QA", "BLOCKED", "REWORK", "DONE", "CANCELLED"]
    },
    "risk_class": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/versionedRef"}
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "artifact_type", "target_uri"],
        "properties": {
          "name": {"type": "string", "minLength": 3},
          "artifact_type": {"$ref": "#/$defs/artifactType"},
          "target_uri": {"type": "string", "minLength": 5}
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "statement", "verification"],
        "properties": {
          "criterion_id": {"type": "string", "pattern": "^AC-[0-9]{3}$"},
          "statement": {"type": "string", "minLength": 10},
          "verification": {"type": "string", "minLength": 5}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[A-Z][A-Z0-9]+-[0-9]{4}$"},
      "uniqueItems": true
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_cost_usd", "max_runtime_seconds", "stop_on_limit"],
      "properties": {
        "max_cost_usd": {"type": "number", "minimum": 0},
        "max_runtime_seconds": {"type": "integer", "minimum": 1},
        "stop_on_limit": {"const": true}
      }
    },
    "approvers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/approver"},
      "uniqueItems": true
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "source_preserved", "verification"],
      "properties": {
        "strategy": {"type": "string", "minLength": 10},
        "source_preserved": {"const": true},
        "verification": {"type": "string", "minLength": 5}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_classification", "contains_pii", "workspace_access", "network_policy", "secrets_policy"],
      "properties": {
        "data_classification": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
        "contains_pii": {"type": "boolean"},
        "workspace_access": {"enum": ["READ_ONLY", "TASK_WRITE", "DEPARTMENT_WRITE"]},
        "network_policy": {"enum": ["NONE", "ALLOWLISTED_READ", "ALLOWLISTED_PROVIDER"]},
        "secrets_policy": {"enum": ["NONE", "REFERENCE_ONLY", "BROKERED_USE"]}
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 5}},
    "open_decisions": {"type": "array", "items": {"type": "string", "minLength": 5}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "agentId": {"type": "string", "pattern": "^A-[0-9]{2}$"},
    "approver": {
      "oneOf": [
        {"$ref": "#/$defs/agentId"},
        {"enum": ["USER", "OWNER_LEAD"]}
      ]
    },
    "artifactType": {
      "enum": ["DOCUMENT", "CODE", "SCHEMA", "BUILD", "IMAGE", "MODEL_3D", "ANIMATION", "VFX", "AUDIO", "TEST_REPORT", "DATASET", "DECISION"]
    },
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "version", "content_hash"],
      "properties": {
        "uri": {"type": "string", "minLength": 5},
        "version": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}

