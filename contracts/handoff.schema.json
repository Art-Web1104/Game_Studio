{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ts-studio.local/contracts/handoff.schema.json",
  "title": "TS STUDIO Handoff Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "task_id",
    "from_agent_id",
    "to_agent_id",
    "created_at",
    "summary",
    "artifact_refs",
    "assumptions",
    "verification_evidence",
    "known_risks",
    "next_action",
    "readiness",
    "acknowledgement_required"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "handoff_id": {"type": "string", "pattern": "^HO-[A-Z0-9-]+-[0-9]{3}$"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[A-Z][A-Z0-9]+-[0-9]{4}$"},
    "from_agent_id": {"$ref": "#/$defs/agentId"},
    "to_agent_id": {"$ref": "#/$defs/agentId"},
    "created_at": {"type": "string", "format": "date-time"},
    "summary": {"type": "string", "minLength": 20},
    "artifact_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^ART-[A-Z0-9-]+-[0-9]{4}$"},
      "uniqueItems": true
    },
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 5}},
    "verification_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "result", "evidence_uri"],
        "properties": {
          "check": {"type": "string", "minLength": 5},
          "result": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
          "evidence_uri": {"type": "string", "minLength": 5}
        }
      }
    },
    "known_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "description", "owner_agent_id"],
        "properties": {
          "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "BLOCKER"]},
          "description": {"type": "string", "minLength": 5},
          "owner_agent_id": {"$ref": "#/$defs/agentId"}
        }
      }
    },
    "next_action": {"type": "string", "minLength": 10},
    "readiness": {"enum": ["READY_FOR_REVIEW", "READY_FOR_QA", "BLOCKED", "REWORK_REQUIRED"]},
    "acknowledgement_required": {"const": true}
  },
  "$defs": {
    "agentId": {"type": "string", "pattern": "^A-[0-9]{2}$"}
  }
}

