{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ts-studio.local/audit/audit-event.schema.json",
  "title": "TS STUDIO Audit Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "event_type", "timestamp", "actor_type", "actor_id",
    "task_id", "action", "resource_refs", "decision", "policy_version", "request_hash",
    "previous_event_hash", "event_hash", "contains_secret"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"type": "string", "pattern": "^AE-[A-Z0-9]+-[0-9]{4}$"},
    "event_type": {"enum": ["TASK_STATE", "APPROVAL", "KNOWLEDGE", "PROVIDER_CALL", "COST", "SECURITY", "ARTIFACT", "RELEASE_GATE"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "actor_type": {"enum": ["USER", "AGENT", "SERVICE"]},
    "actor_id": {"type": "string", "minLength": 2},
    "task_id": {"type": ["string", "null"]},
    "action": {"type": "string", "minLength": 3},
    "resource_refs": {"type": "array", "items": {"type": "string", "minLength": 5}},
    "decision": {"enum": ["ALLOW", "DENY", "START", "COMPLETE", "FAIL", "BLOCK"]},
    "policy_version": {"type": "string", "minLength": 3},
    "request_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "previous_event_hash": {"type": ["string", "null"]},
    "event_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "contains_secret": {"const": false}
  }
}
