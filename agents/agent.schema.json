{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ts-studio.local/schemas/agent.schema.json",
  "title": "TS STUDIO Agent Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_id",
    "slug",
    "role",
    "department",
    "kind",
    "mission",
    "default_room",
    "owns",
    "inputs",
    "outputs",
    "capabilities",
    "permissions",
    "must",
    "must_not",
    "handoff_to",
    "approval_policy",
    "escalate_when",
    "evaluation_profile"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "agent_id": {"type": "string", "pattern": "^A-[0-9]{2}$"},
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "role": {"type": "string", "minLength": 3},
    "department": {
      "enum": ["command", "production", "platform", "knowledge", "design", "engineering", "art", "audio", "qa"]
    },
    "kind": {"const": "permanent"},
    "mission": {"type": "string", "minLength": 20},
    "default_room": {"type": "string", "pattern": "^#[0-9]{2}-[a-z][a-z0-9-]*$"},
    "owns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}},
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "network", "secrets", "production", "approve"],
      "properties": {
        "workspace": {"enum": ["read_only", "department_write", "cross_department_write", "orchestrated_write"]},
        "network": {"enum": ["none", "allowlisted_read", "allowlisted_provider"]},
        "secrets": {"enum": ["none", "reference_only", "brokered_use"]},
        "production": {"const": "no_direct_access"},
        "approve": {"type": "array", "items": {"type": "string"}}
      }
    },
    "must": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 10}},
    "must_not": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 10}},
    "handoff_to": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^A-[0-9]{2}$"}},
    "approval_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "medium", "high"],
      "properties": {
        "low": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "medium": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "high": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "escalate_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "evaluation_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "minimum_score", "independent_reviewer"],
      "properties": {
        "dataset": {"type": "string", "minLength": 3},
        "minimum_score": {"type": "number", "minimum": 0, "maximum": 1},
        "independent_reviewer": {"type": "string", "pattern": "^A-[0-9]{2}$"}
      }
    }
  }
}

