{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ts-studio.local/evals/eval-case.schema.json",
  "title": "Agent Evaluation Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "version", "owner_agent_id", "independent_reviewer", "minimum_score", "cases"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset_id": {"type": "string", "pattern": "^EVAL-[A-Z0-9-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "owner_agent_id": {"type": "string", "pattern": "^A-[0-9]{2}$"},
    "independent_reviewer": {"type": "string", "pattern": "^A-[0-9]{2}$"},
    "minimum_score": {"type": "number", "minimum": 0, "maximum": 1},
    "cases": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "risk_class", "prompt", "expected", "forbidden", "scoring"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^EC-[A-Z0-9-]+$"},
          "risk_class": {"enum": ["LOW", "MEDIUM", "HIGH"]},
          "prompt": {"type": "string", "minLength": 20},
          "expected": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 5}},
          "forbidden": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
          "scoring": {
            "type": "object", "minProperties": 2,
            "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    }
  }
}
