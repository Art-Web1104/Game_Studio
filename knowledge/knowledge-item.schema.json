{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ts-studio.local/knowledge/knowledge-item.schema.json",
  "title": "TS STUDIO Knowledge Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "knowledge_id", "title", "version", "status", "scope",
    "provenance", "rights", "retrieval", "quality", "security", "content_ref",
    "supersedes", "created_at", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "knowledge_id": {"type": "string", "pattern": "^K-[A-Z0-9]+-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 5, "maxLength": 160},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["PROPOSED", "REVIEWED", "APPROVED", "DEPRECATED", "REJECTED"]},
    "scope": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_type", "source_uri", "captured_by", "captured_at", "content_hash"],
      "properties": {
        "source_type": {"enum": ["INTERNAL", "USER_PROVIDED", "LICENSED", "PUBLIC_PRIMARY", "GENERATED"]},
        "source_uri": {"type": "string", "minLength": 5},
        "captured_by": {"type": "string", "pattern": "^A-[0-9]{2}$"},
        "captured_at": {"type": "string", "format": "date-time"},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "rights": {
      "type": "object", "additionalProperties": false,
      "required": ["license", "ai_use_allowed", "commercial_use_allowed", "attribution_required"],
      "properties": {
        "license": {"type": "string", "minLength": 2},
        "ai_use_allowed": {"type": "boolean"},
        "commercial_use_allowed": {"type": "boolean"},
        "attribution_required": {"type": "boolean"}
      }
    },
    "retrieval": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_agents", "tags", "effective_from"],
      "properties": {
        "allowed_agents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "effective_from": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "quality": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer", "evidence_refs", "confidence"],
      "properties": {
        "reviewer": {"type": "string", "pattern": "^A-[0-9]{2}$"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "security": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "contains_pii", "prompt_injection_reviewed"],
      "properties": {
        "classification": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
        "contains_pii": {"type": "boolean"},
        "prompt_injection_reviewed": {"const": true}
      }
    },
    "content_ref": {"type": "string", "minLength": 5},
    "supersedes": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "approved_at": {"type": ["string", "null"], "format": "date-time"},
    "deprecated_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
