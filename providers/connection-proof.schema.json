{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ts-studio.local/providers/connection-proof.schema.json",
  "title": "TS STUDIO Provider Connection Proof",
  "description": "공급자 활성화 게이트가 요구하는 비밀값 없는 실제 연결 증거 기록.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proof_id",
    "provider_id",
    "task_id",
    "recorded_at",
    "recorded_by",
    "verified_by",
    "environment",
    "credential_ref",
    "credential_source",
    "secret_values_recorded",
    "data_classification",
    "user_authorization",
    "probes",
    "overall_result",
    "activation_recommendation",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "proof_id": {"type": "string", "pattern": "^PROOF-[A-Z0-9-]+-[0-9]{3}$"},
    "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,40}$"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[A-Z][A-Z0-9]+-[0-9]{4}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "recorded_by": {"$ref": "#/$defs/agentId"},
    "verified_by": {"$ref": "#/$defs/agentId"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client", "client_surface", "workspace", "operating_system", "model", "contains_secret_values"],
      "properties": {
        "client": {"type": "string", "minLength": 3},
        "client_surface": {"enum": ["interactive_cli_session", "ide_extension", "desktop_app", "api_adapter", "ci_runner"]},
        "workspace": {"type": "string", "minLength": 3},
        "operating_system": {"type": "string", "minLength": 3},
        "model": {"type": ["string", "null"]},
        "contains_secret_values": {"const": false}
      }
    },
    "credential_ref": {"type": "string", "pattern": "^secret-ref://[a-z0-9][a-z0-9/_-]{2,80}$"},
    "credential_source": {"enum": ["OS_CREDENTIAL_STORE", "PROVIDER_NATIVE_AUTH_STORE", "EXTERNAL_SECRET_BROKER"]},
    "secret_values_recorded": {"const": false},
    "data_classification": {"enum": ["PUBLIC", "INTERNAL"]},
    "user_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["granted", "approver", "scope", "granted_at"],
      "properties": {
        "granted": {"const": true},
        "approver": {"const": "USER"},
        "scope": {"type": "string", "minLength": 10},
        "granted_at": {"type": "string", "format": "date-time"}
      }
    },
    "probes": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["probe_id", "name", "method", "blocking", "result", "observed", "evidence_uri"],
        "properties": {
          "probe_id": {"type": "string", "pattern": "^PRB-[0-9]{3}$"},
          "name": {"type": "string", "minLength": 5},
          "method": {"type": "string", "minLength": 5},
          "blocking": {"type": "boolean"},
          "result": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
          "observed": {"type": "string", "minLength": 5},
          "evidence_uri": {"type": "string", "minLength": 5}
        }
      }
    },
    "overall_result": {"enum": ["PASS", "FAIL", "INCOMPLETE"]},
    "activation_recommendation": {"enum": ["ENABLE", "REMAIN_DISABLED_UNTIL_CONFIGURED", "DISABLE"]},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 5}
    },
    "open_decisions": {"type": "array", "items": {"type": "string", "minLength": 5}},
    "notes": {"type": "array", "items": {"type": "string", "minLength": 5}}
  },
  "$defs": {
    "agentId": {"type": "string", "pattern": "^A-[0-9]{2}$"}
  }
}
