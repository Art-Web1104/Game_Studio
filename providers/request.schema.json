{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ts-studio.local/providers/request.schema.json",
  "title": "Provider Adapter Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "task_id", "requesting_agent_id", "capability",
    "risk_class", "data_classification", "input_refs", "output_contract_ref", "budget",
    "permissions", "fallback_allowed", "required_checks"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "pattern": "^PR-[A-Z0-9]+-[0-9]{4}$"},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[A-Z][A-Z0-9]+-[0-9]{4}$"},
    "requesting_agent_id": {"type": "string", "pattern": "^A-[0-9]{2}$"},
    "capability": {"enum": ["orchestration", "code", "reasoning", "image", "audio", "3d", "evaluation"]},
    "risk_class": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "data_classification": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]},
    "input_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "output_contract_ref": {"type": "string", "minLength": 5},
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["estimated_cost_usd", "max_cost_usd", "max_runtime_seconds", "stop_on_limit"],
      "properties": {
        "estimated_cost_usd": {"type": "number", "minimum": 0},
        "max_cost_usd": {"type": "number", "minimum": 0},
        "max_runtime_seconds": {"type": "integer", "minimum": 1},
        "stop_on_limit": {"const": true}
      }
    },
    "permissions": {
      "type": "object", "additionalProperties": false,
      "required": ["network", "workspace", "secret_refs"],
      "properties": {
        "network": {"enum": ["NONE", "ALLOWLISTED_PROVIDER"]},
        "workspace": {"enum": ["READ_ONLY", "TASK_WRITE"]},
        "secret_refs": {"type": "array", "items": {"type": "string", "pattern": "^secret-ref://[a-z0-9/-]+$"}}
      }
    },
    "fallback_allowed": {"type": "boolean"},
    "required_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
  }
}
